#!/bin/sh
# Validates the commit message: Conventional Commits in English, no AI attribution lines.
# Enable once per clone:  git config core.hooksPath .githooks
# Full rules: CONTRIBUTING.md, "Commit messages and pull requests".

msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | sed -n '1p')

# No AI attribution lines.
if grep -qiE '^(Co-Authored-By:.*(Claude|anthropic)|.*Generated with \[?Claude Code)' "$msg_file"; then
  echo "commit-msg: remove the Co-Authored-By / Generated with Claude Code line." >&2
  exit 1
fi

# Messages generated by git pass as they are.
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|data|docs|refactor|perf|test|build|ci|chore|revert'
if ! printf '%s\n' "$subject" | grep -qE "^($types)(\([a-z0-9][a-z0-9-]*\))?!?: [a-z0-9]"; then
  cat >&2 <<MSG
commit-msg: subject must follow Conventional Commits:
  <type>(<scope>): <imperative description, lowercase start>
  types: $types
  e.g.   feat(map): highlight the searched municipality
got:     $subject
MSG
  exit 1
fi

len=$(printf '%s' "$subject" | wc -m)
if [ "$len" -gt 72 ]; then
  echo "commit-msg: subject has $len characters; keep it at 72 or less." >&2
  exit 1
fi

case "$subject" in
  *.) echo "commit-msg: no trailing period in the subject." >&2; exit 1 ;;
esac
exit 0
