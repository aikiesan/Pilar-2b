# PILAR-2b Docker dev environment — copy this file to .env.docker
# (docker-compose.yml reads .env.docker via env_file on the backend service)
#
# DO NOT commit .env.docker — it is listed in .gitignore.

# ── Backend ──────────────────────────────────────────────────────────────────
# DATABASE_URL is overridden in docker-compose.yml to point to the db service;
# set it here only if you want to point at an external database instead.
# DATABASE_URL=postgresql://postgres:password@db:5432/cp2b_maps

# Minimum required for dev — change SECRET_KEY in any shared environment
SECRET_KEY=dev-only-secret-key-change-me

# Optional: Supabase auth (leave blank to disable Supabase auth in dev)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Sentry error tracking (leave blank to disable)
SENTRY_DSN=
