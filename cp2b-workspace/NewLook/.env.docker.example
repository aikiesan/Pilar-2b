# PILAR-2b Docker dev environment — copy this file to .env.docker
# (docker-compose.yml reads .env.docker via env_file on the backend service)
#
# DO NOT commit .env.docker — it is listed in .gitignore.
#
# ── Dev vs. VM production differences ────────────────────────────────────────
#
#   Setting           Docker dev (this file)     VM production
#   ─────────────────────────────────────────────────────────────
#   Backend port      8000                       8001  (Apache proxies /api/ → :8001)
#   Frontend port     3006                       3002  (ecosystem.config.js PORT=3002)
#   API URL           http://localhost:8000      https://cp2b.unicamp.br/pilar2b
#   Database          db container (postgres)    local PostgreSQL on the VM
#   Auth              local PostgreSQL            local PostgreSQL
#   Supabase          not used                   not used
#
# The deploy path on the VM is frontend/deploy.sh — do not bypass it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
# DATABASE_URL is overridden in docker-compose.yml to point at the db container.
# Set it here only if you want to point at an external database instead.
# DATABASE_URL=postgresql://postgres:password@db:5432/cp2b_maps

# Required — generate a real key with: openssl rand -hex 32
SECRET_KEY=dev-only-secret-key-change-me111

APP_ENV=development
DEBUG=true

# CORS: Docker dev frontend runs at localhost:3006
PRODUCTION_ORIGINS=http://localhost:3006

# ── Supabase (not used) ───────────────────────────────────────────────────────
# Supabase has been removed from this project. Leave blank.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional monitoring ───────────────────────────────────────────────────────
SENTRY_DSN=
