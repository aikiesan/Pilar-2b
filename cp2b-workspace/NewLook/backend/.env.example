# PILAR-2b Backend — environment variables template
# Copy to .env and fill in values. Never commit the filled-in file.
#
# ── Dev vs. VM production differences ────────────────────────────────────────
#
#   Setting           Docker dev                  VM production
#   ─────────────────────────────────────────────────────────────────
#   APP_ENV           development                 production
#   DEBUG             true                        false
#   PORT              8000                        8001
#   DATABASE_URL      postgresql://postgres:      postgresql://<vm-user>:
#                       password@db:5432/           <vm-pass>@localhost:
#                       cp2b_maps                   5432/cp2b_maps
#   PRODUCTION_ORIGINS http://localhost:3006       https://pilar2b.cp2b.unicamp.br
#
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
DEBUG=true
PORT=8000

# Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Local PostgreSQL — no Supabase
DATABASE_URL=postgresql://postgres:password@localhost:5432/cp2b_maps
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cp2b_maps
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS allowed origins
# Dev:        http://localhost:3006
# Production: https://pilar2b.cp2b.unicamp.br
PRODUCTION_ORIGINS=http://localhost:3006

# Optional: Sentry error tracking (leave blank to disable)
SENTRY_DSN=
