# Development image for PILAR-2b backend
# Does NOT copy application code — the source tree is bind-mounted by docker-compose.
# The image is only rebuilt when requirements.txt or system deps change.

FROM python:3.11-slim

# System deps: GDAL + libpq (same as production builder stage)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps installed into the system interpreter (no venv needed in dev)
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ENV PYTHONUNBUFFERED=1

# No CMD — overridden by docker-compose (uvicorn --reload)
