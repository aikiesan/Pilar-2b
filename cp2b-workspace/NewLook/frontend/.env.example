# PILAR-2b Frontend — environment variables template
# Copy to .env.local for local development. Never commit the filled-in file.
#
# ── Dev vs. VM production differences ────────────────────────────────────────
#
#   Setting                   Docker dev              VM production
#   ──────────────────────────────────────────────────────────────────────────
#   NEXT_PUBLIC_API_URL       http://localhost:8000   https://cp2b.unicamp.br/pilar2b
#   NEXT_PUBLIC_DISABLE_AUTH  false                   false
#   basePath (next.config.js) /pilar2b                /pilar2b
#   Served at                 localhost:3006          localhost:3002 → Apache → :443
#
# No Supabase — authentication is handled by the local FastAPI backend.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL used by all client-side fetch calls.
# In Docker dev the backend container is reachable at localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set true only to bypass authentication for local testing.
NEXT_PUBLIC_DISABLE_AUTH=false

# Optional: Sentry error tracking (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
