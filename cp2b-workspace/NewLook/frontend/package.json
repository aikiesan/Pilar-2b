{
  "name": "pilar-2b-frontend",
  "version": "3.0.0",
  "private": true,
  "description": "PILAR-2b: Intelligent Waste Location and Utilization Platform for Biogas and Bioproducts - Open-source geospatial framework for biogas potential analysis",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aikiesan/NewLook"
  },
  "keywords": [
    "biogas",
    "bioproducts",
    "geospatial",
    "open-source",
    "next.js",
    "react",
    "sustainability",
    "renewable-energy"
  ],
  "author": "NIPE-UNICAMP / PILAR-2b",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:debug": "jest --verbose --no-cache",
    "test:a11y": "jest --testPathPatterns=a11y",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:public": "playwright test --project=public",
    "test:e2e:ci": "playwright test --project=chromium --reporter=github,html",
    "test:e2e:report": "playwright show-report",
    "pre-commit": "lint-staged && npm run test:a11y -- --bail --passWithNoTests",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@types/leaflet": "^1.9.12",
    "autoprefixer": "^10.5.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "postcss": "^8",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-leaflet": "^4.2.1",
    "reactflow": "^11.10.4",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "glob": "10.5.0",
    "flatted": "3.4.2",
    "lodash": "4.17.21"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.3",
    "axe-core": "^4.10.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.6",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.5",
    "playwright": "^1.57.0",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3"
  }
}
