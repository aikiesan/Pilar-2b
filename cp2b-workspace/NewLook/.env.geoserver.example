# PILAR-2b — GeoServer 3.0 environment — copy this file to .env.geoserver
# (docker-compose.geoserver.yml reads it via env_file). DO NOT commit .env.geoserver.
#
# ── Admin credentials (REQUIRED) ──────────────────────────────────────────────
# The image defaults to admin/geoserver — ALWAYS override before any non-laptop
# use. Generate a strong password:  openssl rand -base64 24
GEOSERVER_ADMIN_USER=admin
# Leave blank here and set a real value in your (gitignored) .env.geoserver.
GEOSERVER_ADMIN_PASSWORD=

# ── JVM heap ──────────────────────────────────────────────────────────────────
# A handful of PostGIS layers needs little; raise MAXIMUM_MEMORY for heavy WMS.
GEOSERVER_INITIAL_MEMORY=1G
GEOSERVER_MAXIMUM_MEMORY=2G

# ── Reverse-proxy public URL (REQUIRED in production) ─────────────────────────
# GeoServer bakes this into GetCapabilities/GetMap URLs. It MUST equal the
# public path clients hit. Local testing default is fine for laptops.
#   Local:       http://localhost:8080/geoserver
#   Production:   https://cp2b.unicamp.br/pilar2b/geoserver
# (If you front GeoServer under the pilar2b.cp2b.unicamp.br subdomain instead,
#  use https://pilar2b.cp2b.unicamp.br/geoserver — keep it consistent with the
#  Apache block you enable; see apache/pilar2b-geoserver.conf.draft.)
GEOSERVER_PROXY_BASE_URL=http://localhost:8080/geoserver

# ── Misc ──────────────────────────────────────────────────────────────────────
GEOSERVER_PORT=8080
GEOSERVER_CORS_ENABLED=true
GEOSERVER_SKIP_DEMO_DATA=true

# ── PostGIS target the provisioning script connects GeoServer to ──────────────
# When running as the overlay (docker-compose.yml + this file), the DB is the
# `db` service, reachable as host `db` on the compose network. The provisioning
# script (scripts/geoserver/provision_geoserver.py) reads these.
GEOSERVER_DB_HOST=db
GEOSERVER_DB_PORT=5432
GEOSERVER_DB_NAME=cp2b_maps
GEOSERVER_DB_SCHEMA=public
GEOSERVER_DB_USER=postgres
# Must match the PostGIS DB password. Leave blank here; set it in .env.geoserver.
GEOSERVER_DB_PASSWORD=

# Where the provisioning script reaches the GeoServer REST API from the HOST.
# (Inside the compose network it would be http://geoserver:8080/geoserver.)
GEOSERVER_REST_URL=http://localhost:8080/geoserver
GEOSERVER_WORKSPACE=cp2b
GEOSERVER_DATASTORE=cp2b_postgis
