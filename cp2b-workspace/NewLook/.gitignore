*~# Shapefile data (large files, sourced from project_map repo)
backend/data/shapefiles/
backend/data/rasters/
# Immutable raw snapshots for the ingestion contract (backend/ingest). These are
# large source exports (IBGE SIDRA workbooks, SNIS CSVs) that are downloaded
# deliberately and recorded in docs/data/METADATA.json — the lineage lives there,
# not in git. The rule at line 36 only covers NewLook/data/raw, not this one.
backend/data/raw/

# Canonical recalculation outputs (regenerable via recalculate_biogas_canonical.py)
backend/scripts/canonical_recalc_output/

# Test coverage artifacts (regenerable via pytest --cov)
.coverage
coverage.xml
htmlcov/

# CITE EARL reports (regenerable via tests/ogc/cite/run_cite.py; CI uploads as artifacts)
tests/ogc/cite/reports/

# Local Docker overrides — machine-specific absolute paths (e.g. pointing the
# backend bind-mount at a git worktree, or sharing the gitignored 698 MB
# data/shapefiles/ across checkouts). Never commit: it is per-developer config.
docker-compose.override.yml
